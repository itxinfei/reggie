+              cancelButtonText: '鍙栨秷',
+              type: 'warning'
+            }).then(() => {
+              deleteSupplier(id).then(res => {
+                if (res.code === 1) {
+                  this.$message.success('鍒犻櫎鎴愬姛锛?)
+                  this.handleQuery()
+                } else {
+                  this.$message.error(res.msg || '鎿嶄綔澶辫触')
+                }
+              }).catch(err => {
+                this.$message.error('璇锋眰鍑洪敊浜嗭細' + err)
+              })
+            })
+          },
+          submitForm() {
+            const fd = this.formData
+            if (!fd.name) {
+              this.$message.error('璇疯緭鍏ヤ緵搴斿晢鍚嶇О')
+              return
+            }
+            if (this.action === 'add') {
+              addSupplier({ name: fd.name, contact: fd.contact, phone: fd.phone, address: fd.address, status: fd.status }).then(res => {
+                if (res.code === 1) {
+                  this.$message.success('娣诲姞鎴愬姛锛?)
+                  this.formData.dialogVisible = false
+                  this.handleQuery()
+                } else {
+                  this.$message.error(res.msg || '鎿嶄綔澶辫触')
+                }
+              }).catch(err => {
+                this.$message.error('璇锋眰鍑洪敊浜嗭細' + err)
+              })
+            } else {
+              updateSupplier({ id: fd.id, name: fd.name, contact: fd.contact, phone: fd.phone, address: fd.address, status: fd.status }).then(res => {
+                if (res.code === 1) {
+                  this.$message.success('淇敼鎴愬姛锛?)
+                  this.formData.dialogVisible = false
+                  this.handleQuery()
+                } else {
+                  this.$message.error(res.msg || '鎿嶄綔澶辫触')
+                }
+              }).catch(err => {
+                this.$message.error('璇锋眰鍑洪敊浜嗭細' + err)
+              })
