+            <el-radio :label="'0'">绂佺敤</el-radio>
+          </el-radio-group>
+        </el-form-item>
+      </el-form>
+      <span slot="footer" class="dialog-footer">
+        <el-button size="medium" @click="formData.dialogVisible = false">鍙?娑?/el-button>
+        <el-button type="primary" size="medium" @click="submitForm()">纭?瀹?/el-button>
+      </span>
+    </el-dialog>
+  </div>
+    <script src="../../plugins/vue/vue.js"></script>
+    <script src="../../plugins/element-ui/index.js"></script>
+    <script src="../../plugins/axios/axios.min.js"></script>
+    <script src="../../js/request.js"></script>
+    <script src="../../api/inventory.js"></script>
+    <script>
+      new Vue({
+        el: '#supplier-app',
+        data() {
+          return {
+            action: '',
+            counts: 0,
+            page: 1,
+            pageSize: 10,
+            tableData: [],
+            input: {
+              name: '',
+              contact: ''
+            },
+            formData: {
+              title: '鏂板渚涘簲鍟?,
+              dialogVisible: false,
+              id: '',
+              name: '',
+              contact: '',
+              phone: '',
+              address: '',
+              status: '1'
+            }
+          }
+        },
+        created() {
+          this.init()
+        },
+        methods: {
+          async init() {
+            const params = { page: this.page, pageSize: this.pageSize }
+            if (this.input.name) params.name = this.input.name
+            if (this.input.contact) params.contact = this.input.contact
+            await supplierPage(params).then(res => {
+              if (String(res.code) === '1') {
+                this.tableData = res.data.records
+                this.counts = Number(res.data.total)
+              } else {
+                this.$message.error(res.msg || '鎿嶄綔澶辫触')
+              }
+            }).catch(err => {
+              this.$message.error('璇锋眰鍑洪敊浜嗭細' + err)
+            })
+          },
+          handleQuery() {
+            this.page = 1
+            this.init()
+          },
+          addHandle() {
