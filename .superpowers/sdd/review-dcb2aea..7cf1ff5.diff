+              if (res.code === 1) this.materialOptions = res.data
+            })
+          },
+          handleQuery() {
+            this.page = 1
+            this.init()
+          },
+          handleSizeChange(val) {
+            this.pageSize = val
+            this.init()
+          },
+          handleCurrentChange(val) {
+            this.page = val
+            this.init()
+          }
+        }
+      })
+    </script>
+</body>
+</html>
