+          <el-option label="鍏ュ簱" value="IN"></el-option>
+          <el-option label="鍑哄簱" value="OUT"></el-option>
+          <el-option label="鐩樼偣" value="CHECK"></el-option>
+        </el-select>
+        <el-date-picker v-model="input.dateRange" type="daterange" range-separator="鑷? start-placeholder="寮€濮嬫棩鏈? end-placeholder="缁撴潫鏃ユ湡" style="margin-left: 10px" value-format="yyyy-MM-dd" @change="handleQuery"></el-date-picker>
+        <el-button type="primary" style="margin-left: 10px" @click="handleQuery">鏌ヨ</el-button>
+      </div>
+      <el-table :data="tableData" stripe class="tableBox">
+        <el-table-column label="椋熸潗鍚嶇О">
+          <template slot-scope="scope">{{ scope.row.materialName }}</template>
+        </el-table-column>
+        <el-table-column label="绫诲瀷">
+          <template slot-scope="scope">
+            <el-tag :type="scope.row.type == 'IN' ? 'primary' : scope.row.type == 'OUT' ? 'danger' : 'info'">
+              {{ scope.row.type == 'IN' ? '鍏ュ簱' : scope.row.type == 'OUT' ? '鍑哄簱' : '鐩樼偣' }}
+            </el-tag>
+          </template>
+        </el-table-column>
+        <el-table-column prop="quantity" label="鏁伴噺" /></el-table-column>
+        <el-table-column label="鍗曚环">
+          <template slot-scope="scope">锟{ scope.row.unitPrice }}</template>
+        </el-table-column>
+        <el-table-column label="鎬婚噾棰?>
+          <template slot-scope="scope">锟{ scope.row.totalAmount }}</template>
+        </el-table-column>
+        <el-table-column prop="remark" label="澶囨敞" /></el-table-column>
+        <el-table-column prop="createdTime" label="鎿嶄綔鏃堕棿" width="160" /></el-table-column>
+      </el-table>
+      <el-pagination class="pageList" :page-sizes="[10,20,30,40]" :page-size="pageSize" layout="total, sizes, prev, pager, next, jumper" :total="counts" @size-change="handleSizeChange" @current-change="handleCurrentChange"></el-pagination>
+    </div>
+  </div>
+    <script src="../../plugins/vue/vue.js"></script>
+    <script src="../../plugins/element-ui/index.js"></script>
+    <script src="../../plugins/axios/axios.min.js"></script>
+    <script src="../../js/request.js"></script>
+    <script src="../../api/inventory.js"></script>
+    <script>
+      new Vue({
+        el: '#stock-record-app',
+        data() {
+          return {
+            counts: 0,
+            page: 1,
+            pageSize: 10,
+            tableData: [],
+            materialOptions: [],
+            input: {
+              materialId: '',
+              type: '',
+              dateRange: ''
+            }
+          }
+        },
+        created() {
+          this.init()
+          this.loadMaterialOptions()
+        },
+        methods: {
+          async init() {
+            const params = { page: this.page, pageSize: this.pageSize }
+            if (this.input.materialId) params.materialId = this.input.materialId
+            if (this.input.type) params.type = this.input.type
+            if (this.input.dateRange) {
+              params.startDate = this.input.dateRange[0]
+              params.endDate = this.input.dateRange[1]
+            }
+            await stockRecordPage(params).then(res => {
+              if (String(res.code) === '1') {
+                this.tableData = res.data.records
+                this.counts = Number(res.data.total)
+              } else {
+                this.$message.error(res.msg || '鎿嶄綔澶辫触')
+              }
