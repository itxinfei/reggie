+  <script src="../../plugins/vue/vue.js"></script>
+  <script src="../../plugins/element-ui/index.js"></script>
+  <script src="../../plugins/axios/axios.min.js"></script>
+  <script src="../../js/request.js"></script>
+  <script src="../../api/dining.js"></script>
+  <script>
+    new Vue({
+      el: '#area-app',
+      data() {
+        return {
+          input: '',
+          counts: 0,
+          page: 1,
+          pageSize: 10,
+          tableData: [],
+          dialog: {
+            title: '',
+            visible: false
+          },
+          form: {
+            id: '',
+            name: '',
+            sort: ''
+          },
+          action: ''
+        }
+      },
+      created() {
+        this.init()
+      },
+      methods: {
+        async init() {
+          const params = {
+            page: this.page,
+            pageSize: this.pageSize,
+            name: this.input || undefined
+          }
+          await areaPage(params).then(res => {
+            if (String(res.code) === '1') {
+              this.tableData = res.data.records || []
+              this.counts = res.data.total
+            } else {
+              this.$message.error(res.msg || '鎿嶄綔澶辫触')
+            }
+          }).catch(err => {
+            this.$message.error('璇锋眰鍑洪敊浜嗭細' + err)
+          })
+        },
+        handleQuery() {
+          this.page = 1
+          this.init()
+        },
+        addHandle() {
+          this.action = 'add'
+          this.dialog.title = '鏂板鍖哄煙'
+          this.form.id = ''
+          this.form.name = ''
+          this.form.sort = ''
+          this.dialog.visible = true
+        },
+        editHandle(row) {
+          this.action = 'edit'
+          this.dialog.title = '淇敼鍖哄煙'
+          this.form.id = row.id
+          this.form.name = row.name
+          this.form.sort = row.sort
+          this.dialog.visible = true
+        },
+        handleClose() {
+          this.dialog.visible = false
+        },
+        submitForm() {
+          if (!this.form.name && this.form.name !== 0) {
+            this.$message.error('璇疯緭鍏ュ尯鍩熷悕绉?)
+            return
+          }
+          if (!this.form.sort && this.form.sort !== 0) {
+            this.$message.error('璇疯緭鍏ユ帓搴?)
+            return
+          }
+          const reg = /^\d+$/
+          if (!reg.test(String(this.form.sort))) {
+            this.$message.error('鎺掑簭鍙兘杈撳叆鏁板瓧绫诲瀷')
+            return
+          }
+          if (this.action === 'add') {
+            addArea({ name: this.form.name, sort: this.form.sort }).then(res => {
+              if (res.code === 1) {
+                this.$message.success('鍖哄煙娣诲姞鎴愬姛锛?)
+                this.dialog.visible = false
+                this.handleQuery()
+              } else {
+                this.$message.error(res.msg || '鎿嶄綔澶辫触')
+              }
+            }).catch(err => {
+              this.$message.error('璇锋眰鍑洪敊浜嗭細' + err)
+            })
+          } else {
+            updateArea({ id: this.form.id, name: this.form.name, sort: this.form.sort }).then(res => {
+              if (res.code === 1) {
+                this.$message.success('鍖哄煙淇敼鎴愬姛锛?)
+                this.dialog.visible = false
+                this.handleQuery()
+              } else {
+                this.$message.error(res.msg || '鎿嶄綔澶辫触')
+              }
+            }).catch(err => {
+              this.$message.error('璇锋眰鍑洪敊浜嗭細' + err)
+            })
+          }
+        },
+        deleteHandle(id) {
+          this.$confirm('纭鍒犻櫎璇ュ尯鍩? 鏄惁缁х画?', '纭畾鍒犻櫎', {
+            confirmButtonText: '纭畾',
+            cancelButtonText: '鍙栨秷'
+          }).then(() => {
+            deleteArea(id).then(res => {
+              if (res.code === 1) {
+                this.$message.success('鍒犻櫎鎴愬姛锛?)
+                this.handleQuery()
+              } else {
+                this.$message.error(res.msg || '鎿嶄綔澶辫触')
+              }
+            }).catch(err => {
+              this.$message.error('璇锋眰鍑洪敊浜嗭細' + err)
+            })
+          })
+        },
+        handleSizeChange(val) {
+          this.pageSize = val
+          this.init()
+        },
+        handleCurrentChange(val) {
+          this.page = val
+          this.init()
+        }
+      }
+    })
+  </script>
+</body>
+</html>
