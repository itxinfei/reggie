+<body>
+  <div class="dashboard-container" id="area-app">
+    <div class="container">
+      <div class="tableBar">
+        <el-input v-model="input" placeholder="璇疯緭鍏ュ尯鍩熷悕绉? style="width: 250px" clearable @keyup.enter.native="handleQuery">
+          <i slot="prefix" class="el-input__icon el-icon-search" style="cursor: pointer" @click="init"></i>
+        </el-input>
+        <div class="tableLab">
+          <el-button type="primary" @click="addHandle">+ 鏂板鍖哄煙</el-button>
+        </div>
+      </div>
+      <el-table :data="tableData" stripe class="tableBox">
+        <el-table-column type="index" label="搴忓彿" width="50"></el-table-column>
+        <el-table-column prop="name" label="鍖哄煙鍚嶇О"></el-table-column>
+        <el-table-column prop="sort" label="鎺掑簭"></el-table-column>
+        <el-table-column label="鎿嶄綔" width="160" align="center">
+          <template slot-scope="scope">
+            <el-button type="text" size="small" class="blueBug" @click="editHandle(scope.row)">淇敼</el-button>
+            <el-button type="text" size="small" class="delBut non" @click="deleteHandle(scope.row.id)">鍒犻櫎</el-button>
+          </template>
+        </el-table-column>
+      </el-table>
+      <el-pagination
+        class="pageList"
+        :page-sizes="[10, 20, 30, 40]"
+        :page-size="pageSize"
+        layout="total, sizes, prev, pager, next, jumper"
+        :total="counts"
+        @size-change="handleSizeChange"
+        :current-page.sync="page"
+        @current-change="handleCurrentChange"
+      ></el-pagination>
+    </div>
+    <el-dialog :title="dialog.title" :visible.sync="dialog.visible" width="30%" :before-close="handleClose">
+      <el-form ref="form" :model="form" label-width="100px">
+        <el-form-item label="鍖哄煙鍚嶇О锛?>
+          <el-input v-model="form.name" placeholder="璇疯緭鍏ュ尯鍩熷悕绉? maxlength="14" />
+        </el-form-item>
+        <el-form-item label="鎺掑簭锛?>
+          <el-input v-model="form.sort" type="number" placeholder="璇疯緭鍏ユ帓搴? />
+        </el-form-item>
+      </el-form>
+      <span slot="footer" class="dialog-footer">
+        <el-button size="medium" @click="handleClose">鍙?娑?/el-button>
+        <el-button type="primary" size="medium" @click="submitForm">纭?瀹?/el-button>
+      </span>
+    </el-dialog>
