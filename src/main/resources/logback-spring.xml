<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 引入 Spring Boot 默认配置 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 日志文件存储路径 -->
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="logs"/>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="reggie"/>

    <!-- 控制台输出（开发环境） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId}] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 全部日志文件（30天滚动） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId}] %-5level %logger{50} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 按天滚动 -->
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 保留30天 -->
            <maxHistory>30</maxHistory>
            <!-- 总大小限制 1GB -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 错误日志文件（90天保留，用于告警） -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId}] %-5level %logger{50} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 按天滚动 -->
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 保留90天 -->
            <maxHistory>90</maxHistory>
            <!-- 总大小限制 500MB -->
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 异步日志（提升性能） -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FILE"/>
    </appender>

    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <!--
      开发环境：控制台 + 文件
      ★ 日志策略（2026-09-15 明确）：平时不刷屏，仅报错（ERROR 及以上）才输出
        - root level="ERROR"：全局只放行 ERROR 日志（INFO/WARN/DEBUG 全部吞掉）
        - ERROR 日志同时写入两处：控制台 + logs/reggie-error.log（告警排查用）
        - 注意：application-dev.yml 的 mybatis-plus log-impl 必须保持 Slf4jImpl，
          若改回 StdOutImpl 会绕过这里的级别控制，控制台重新被 SQL 刷屏
      【临时调试】需要看某个包的 INFO/DEBUG 日志时，在下面"第三方框架日志级别"区
        或 application-dev.yml 的 logging.level 里按包开级别，不要动 root，例如：
        <logger name="com.reggie.module.member" level="DEBUG"/>
    -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- 生产环境：文件（异步） -->
    <springProfile name="prod">
        <root level="ERROR">
            <!-- 同步控制台：root=ERROR 故平时不刷屏；启动失败时错误即时可见，
                 避免只靠异步文件在 JVM 退出前来不及落盘 -->
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </root>
    </springProfile>

    <!--
      第三方框架日志级别（全部压到 ERROR，防止框架 INFO/WARN 刷屏）
      ★ 项目业务包 com.reggie 未单独配置，跟随 root=ERROR：
          业务代码里的 log.error(...) 会正常输出并进 error 日志文件；
          log.info / log.warn 开发期默认不打印，需要时按包在这里加 <logger> 开 DEBUG/INFO
    -->
    <logger name="org.springframework" level="ERROR"/>
    <logger name="com.baomidou" level="ERROR"/>
    <logger name="com.mysql" level="ERROR"/>
    <logger name="org.apache.ibatis" level="ERROR"/>
    <logger name="org.springframework.boot.actuate" level="ERROR"/>

</configuration>
