<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.reggie.module.member.mapper.MemberTagMapper">

    <!-- 根据租户ID和业务标签分组统计数量 -->
    <select id="countByBizTag" resultType="map">
        SELECT biz_tag as bizTag, COUNT(*) as count
        FROM member_tag
        WHERE tenant_id = #{tenantId}
        GROUP BY biz_tag
    </select>

</mapper>
